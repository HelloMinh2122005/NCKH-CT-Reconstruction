<shape aspect="variable" h="120" w="100" name="PatchTokenizerBlock" strokewidth="inherit">
  <connections>
    <constraint x="0" y="0.57" perimeter="0" name="W"/>
    <constraint x="1" y="0.43" perimeter="0" name="E"/>
    <constraint x="0.5" y="0" perimeter="0" name="N"/>
    <constraint x="0.4" y="1" perimeter="0" name="S"/>
    <constraint x="0.4" y="0.57" perimeter="0" name="Center"/>
  </connections>
  <background>
    <!-- 1. Viền ngoài mặt trên (Top Face) -->
    <path>
      <move x="0" y="16"/>
      <line x="20" y="0"/>
      <line x="100" y="0"/>
      <line x="80" y="16"/>
      <close/>
    </path>
    <!-- 2. Viền ngoài mặt bên phải (Right Depth Face) -->
    <path>
      <move x="80" y="16"/>
      <line x="100" y="0"/>
      <line x="100" y="104"/>
      <line x="80" y="120"/>
      <close/>
    </path>
    <!-- 3. Viền ngoài mặt trước (Front Face) -->
    <path>
      <move x="0" y="16"/>
      <line x="80" y="16"/>
      <line x="80" y="120"/>
      <line x="0" y="120"/>
      <close/>
    </path>

    <!-- 4. Lưới chia Patch 4x4 trên mặt trước (Front Grid Lines) -->
    <!-- Các đường phân cách dọc -->
    <path>
      <move x="20" y="16"/><line x="20" y="120"/>
      <move x="40" y="16"/><line x="40" y="120"/>
      <move x="60" y="16"/><line x="60" y="120"/>
    </path>
    <!-- Các đường phân cách ngang -->
    <path>
      <move x="0" y="42"/><line x="80" y="42"/>
      <move x="0" y="68"/><line x="80" y="68"/>
      <move x="0" y="94"/><line x="80" y="94"/>
    </path>

    <!-- 5. Đường gióng phân chia Patch trên mặt trên (Top Grid Lines) -->
    <path>
      <move x="20" y="16"/><line x="40" y="0"/>
      <move x="40" y="16"/><line x="60" y="0"/>
      <move x="60" y="16"/><line x="80" y="0"/>
    </path>

    <!-- 6. Đường gióng phân chia Patch trên mặt bên phải (Side Grid Lines) -->
    <path>
      <move x="80" y="42"/><line x="100" y="26"/>
      <move x="80" y="68"/><line x="100" y="52"/>
      <move x="80" y="94"/><line x="100" y="78"/>
    </path>
  </background>
  <foreground>
    <fillstroke/>
  </foreground>
</shape>
