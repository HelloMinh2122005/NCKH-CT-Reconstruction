<shape aspect="variable" h="120" w="100" name="UntokenizerBlock" strokewidth="inherit">
  <connections>
    <constraint x="0" y="0.57" perimeter="0" name="W"/>
    <constraint x="1" y="0.43" perimeter="0" name="E"/>
    <constraint x="0.5" y="0" perimeter="0" name="N"/>
    <constraint x="0.4" y="1" perimeter="0" name="S"/>
    <constraint x="0.4" y="0.57" perimeter="0" name="Center"/>
  </connections>
  <background>
    <!-- 1. Mặt trên (Top Face) -->
    <path>
      <move x="0" y="16"/>
      <line x="20" y="0"/>
      <line x="100" y="0"/>
      <line x="80" y="16"/>
      <close/>
    </path>
    <!-- 2. Mặt bên phải (Right Depth Face) -->
    <path>
      <move x="80" y="16"/>
      <line x="100" y="0"/>
      <line x="100" y="104"/>
      <line x="80" y="120"/>
      <close/>
    </path>
    <!-- 3. Mặt trước (Front Face) -->
    <path>
      <move x="0" y="16"/>
      <line x="80" y="16"/>
      <line x="80" y="120"/>
      <line x="0" y="120"/>
      <close/>
    </path>

    <!-- 4. Các đường nếp gấp hội tụ tái tạo ảnh 2D (Reassembly / Folding Lines T_2x2^-1) -->
    <path>
      <!-- Từ các góc token rời rạc hội tụ về nút trung tâm -->
      <move x="0" y="42"/><line x="40" y="68"/>
      <move x="0" y="94"/><line x="40" y="68"/>
      <move x="20" y="16"/><line x="40" y="68"/>
      <move x="20" y="120"/><line x="40" y="68"/>
      <!-- Mở rộng thành khối ảnh liền mạch ở nửa sau -->
      <move x="40" y="68"/><line x="80" y="42"/>
      <move x="40" y="68"/><line x="80" y="94"/>
    </path>
  </background>
  <foreground>
    <fillstroke/>
  </foreground>
</shape>
