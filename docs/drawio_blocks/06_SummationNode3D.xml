<shape aspect="variable" h="60" w="60" name="SummationNode3D" strokewidth="inherit">
  <connections>
    <constraint x="0" y="0.5" perimeter="0" name="W"/>
    <constraint x="1" y="0.5" perimeter="0" name="E"/>
    <constraint x="0.5" y="0" perimeter="0" name="N"/>
    <constraint x="0.5" y="1" perimeter="0" name="S"/>
    <constraint x="0.15" y="0.15" perimeter="0" name="NW"/>
    <constraint x="0.15" y="0.85" perimeter="0" name="SW"/>
    <constraint x="0.85" y="0.15" perimeter="0" name="NE"/>
    <constraint x="0.85" y="0.85" perimeter="0" name="SE"/>
    <constraint x="0.5" y="0.5" perimeter="0" name="Center"/>
  </connections>
  <background>
    <!-- 1. Vòng tròn ngoài (Outer Circle Body) -->
    <ellipse x="0" y="0" w="60" h="60"/>

    <!-- 2. Vành viền bóng 3D bên trong (Inner Bevel Rim) -->
    <ellipse x="5" y="5" w="50" h="50"/>

    <!-- 3. Dấu cộng dày nổi khối ở tâm (+) (Thick Plus Symbol) -->
    <path>
      <move x="26" y="16"/>
      <line x="34" y="16"/>
      <line x="34" y="26"/>
      <line x="44" y="26"/>
      <line x="44" y="34"/>
      <line x="34" y="34"/>
      <line x="34" y="44"/>
      <line x="26" y="44"/>
      <line x="26" y="34"/>
      <line x="16" y="34"/>
      <line x="16" y="26"/>
      <line x="26" y="26"/>
      <close/>
    </path>
  </background>
  <foreground>
    <fillstroke/>
  </foreground>
</shape>
